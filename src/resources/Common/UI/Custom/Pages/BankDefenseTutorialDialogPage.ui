$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 980, Height: 430);

  #Title {
    Group {
      LayoutMode: Left;

      $C.@Title #TitleLabel {
        @Text = "Duplo TD: tutorial";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group {
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      LayoutMode: Left;
      Anchor: (Height: 286, Bottom: 14);
      Padding: (Horizontal: 18, Vertical: 18);

      Group {
        Anchor: (Width: 220, Height: 220, Right: 18);
        Background: #0b1524(0.92);
        Padding: (Horizontal: 10, Vertical: 10);

        Group {
          Anchor: (Width: 200, Height: 200);

          Group #AvatarDefault {
            Anchor: (Width: 200, Height: 200);
            Background: (TexturePath: "TutorialIcons/wizard_defaultlook.png", Border: 8);
            Visible: false;
          }

          Group #AvatarHello {
            Anchor: (Width: 200, Height: 200);
            Background: (TexturePath: "TutorialIcons/wizard_hellowithhand.png", Border: 8);
            Visible: false;
          }
        }
      }

      Group {
        LayoutMode: Top;
        Anchor: (Width: 706);

        Label #Speaker {
          Style: (FontSize: 28, TextColor: #f4d06f, RenderBold: true, Wrap: true);
          Text: "Wizard Kweebec";
        }

        Label #Body {
          Anchor: (Top: 14, Bottom: 18);
          Style: (FontSize: 18, TextColor: #f3f7ff, Wrap: true);
          Text: "";
        }

        Group {
          LayoutMode: Left;

          Group {
            Anchor: (Width: 446, Height: 1, Right: 12);
          }

          $C.@TextButton #AdvanceButton {
            @Anchor = (Width: 248, Height: 44);
            @Text = "Continue";
          }
        }
      }
    }

    Group {
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Height: 48);
      Padding: (Horizontal: 12, Vertical: 12);

      Label #Hint {
        Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true);
        Text: "";
      }
    }
  }
}

$C.@BackButton {}
