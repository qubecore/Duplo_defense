$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1100, Height: 760);

  #Title {
    Group {
      LayoutMode: Left;

      $C.@Title #TitleLabel {
        @Text = "Duplo TD: match setup";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group #SetupPanel {
      LayoutMode: Top;

      Group #DifficultyPanel {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label #DifficultySubtitle {
          Anchor: (Bottom: 10);
          Style: (FontSize: 13, TextColor: #96a9be, Wrap: true);
          Text: "Step 1: choose a difficulty.";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 312, Bottom: 12);

          Group #DifficultyCard01 {
            Anchor: (Width: 492, Height: 312, Right: 16);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);

            Group { Anchor: (Width: 136, Height: 136, Left: 162, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/difficulty_1.png", Border: 8); }
            Label #DifficultyTitle01 { Anchor: (Bottom: 6); Style: (FontSize: 22, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Difficulty"; }
            Label #DifficultyNote01 { Anchor: (Width: 460, Height: 82, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #DifficultyButton01 { @Anchor = (Width: 460, Height: 40); @Text = "Select"; }
          }

          Group #DifficultyCard02 {
            Anchor: (Width: 492, Height: 312);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);

            Group { Anchor: (Width: 136, Height: 136, Left: 162, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/difficulty_2.png", Border: 8); }
            Label #DifficultyTitle02 { Anchor: (Bottom: 6); Style: (FontSize: 22, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Difficulty"; }
            Label #DifficultyNote02 { Anchor: (Width: 460, Height: 82, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #DifficultyButton02 { @Anchor = (Width: 460, Height: 40); @Text = "Select"; }
          }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 312);

          Group #DifficultyCard03 {
            Anchor: (Width: 492, Height: 312, Right: 16);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);

            Group { Anchor: (Width: 136, Height: 136, Left: 162, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/difficulty_3.png", Border: 8); }
            Label #DifficultyTitle03 { Anchor: (Bottom: 6); Style: (FontSize: 22, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Difficulty"; }
            Label #DifficultyNote03 { Anchor: (Width: 460, Height: 82, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #DifficultyButton03 { @Anchor = (Width: 460, Height: 40); @Text = "Select"; }
          }

          Group #DifficultyCard04 {
            Anchor: (Width: 492, Height: 312);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);

            Group { Anchor: (Width: 136, Height: 136, Left: 162, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/difficulty_4.png", Border: 8); }
            Label #DifficultyTitle04 { Anchor: (Bottom: 6); Style: (FontSize: 22, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Difficulty"; }
            Label #DifficultyNote04 { Anchor: (Width: 460, Height: 82, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #DifficultyButton04 { @Anchor = (Width: 460, Height: 40); @Text = "Select"; }
          }
        }
      }

      Group #ContractPanel {
        Visible: false;
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label #ContractSubtitle {
          Anchor: (Bottom: 10);
          Style: (FontSize: 13, TextColor: #96a9be, Wrap: true);
          Text: "Step 2: choose a contract.";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 294, Bottom: 12);

          Group #ContractCard01 {
            Anchor: (Width: 322, Height: 294, Right: 12);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);
            Group { Anchor: (Width: 112, Height: 112, Left: 89, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/contract_none.png", Border: 8); }
            Label #ContractTitle01 { Anchor: (Bottom: 6); Style: (FontSize: 18, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Contract"; }
            Label #ContractNote01 { Anchor: (Width: 290, Height: 92, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #ContractButton01 { @Anchor = (Width: 290, Height: 38); @Text = "Play"; }
          }

          Group #ContractCard02 {
            Anchor: (Width: 322, Height: 294, Right: 12);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);
            Group { Anchor: (Width: 112, Height: 112, Left: 89, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/contract_triple_breach.png", Border: 8); }
            Label #ContractTitle02 { Anchor: (Bottom: 6); Style: (FontSize: 18, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Contract"; }
            Label #ContractNote02 { Anchor: (Width: 290, Height: 92, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #ContractButton02 { @Anchor = (Width: 290, Height: 38); @Text = "Play"; }
          }

          Group #ContractCard03 {
            Anchor: (Width: 322, Height: 294);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);
            Group { Anchor: (Width: 112, Height: 112, Left: 89, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/contract_lean_purse.png", Border: 8); }
            Label #ContractTitle03 { Anchor: (Bottom: 6); Style: (FontSize: 18, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Contract"; }
            Label #ContractNote03 { Anchor: (Width: 290, Height: 92, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #ContractButton03 { @Anchor = (Width: 290, Height: 38); @Text = "Play"; }
          }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 294);

          Group #ContractCard04 {
            Anchor: (Width: 322, Height: 294, Right: 12);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);
            Group { Anchor: (Width: 112, Height: 112, Left: 89, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/contract_necrotic_mist.png", Border: 8); }
            Label #ContractTitle04 { Anchor: (Bottom: 6); Style: (FontSize: 18, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Contract"; }
            Label #ContractNote04 { Anchor: (Width: 290, Height: 92, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #ContractButton04 { @Anchor = (Width: 290, Height: 38); @Text = "Play"; }
          }

          Group #ContractCard05 {
            Anchor: (Width: 322, Height: 294);
            LayoutMode: Top;
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
            Padding: (Horizontal: 16, Vertical: 16);
            Group { Anchor: (Width: 112, Height: 112, Left: 89, Bottom: 8); Background: (TexturePath: "SuperTowerIcons/contract_storm_front.png", Border: 8); }
            Label #ContractTitle05 { Anchor: (Bottom: 6); Style: (FontSize: 18, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Contract"; }
            Label #ContractNote05 { Anchor: (Width: 290, Height: 92, Bottom: 10); Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true); Text: ""; }
            $C.@TextButton #ContractButton05 { @Anchor = (Width: 290, Height: 38); @Text = "Play"; }
          }
        }
      }
    }

    Group #ControlPanel {
      Visible: false;
      LayoutMode: Top;

      Group {
        Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
        LayoutMode: Top;
        Anchor: (Bottom: 12);
        Padding: (Horizontal: 14, Vertical: 14);

        Label #Wave { Style: (FontSize: 16, RenderBold: true, TextColor: #ffffff); Text: "Wave"; }
        Label #Balance { Anchor: (Top: 6); Style: (FontSize: 16, RenderBold: true, TextColor: #E8A93B); Text: "Funds"; }
        Label #Bank { Anchor: (Top: 6); Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, Wrap: true); Text: "Hollow Health"; }
        Label #Status { Anchor: (Top: 6); Style: (FontSize: 14, RenderBold: true, TextColor: #96a9be, Wrap: true); Text: "Status"; }
      }

      Label #ActionHeader {
        Anchor: (Bottom: 8);
        Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #878e9c);
        Text: "Match";
      }

      Group {
        LayoutMode: Top;
        Anchor: (Bottom: 12);

        $C.@SecondaryTextButton #RewardButton { @Anchor = (Width: 316, Height: 40, Bottom: 8); @Text = "Choose module"; Visible: false; }
        $C.@SecondaryTextButton #StartWave { @Anchor = (Width: 316, Height: 40, Bottom: 8); @Text = "Start wave"; }
        $C.@SecondaryTextButton #AutoStartToggle { @Anchor = (Width: 316, Height: 40, Bottom: 8); @Text = "Instant auto-start"; }
        $C.@SecondaryTextButton #PauseToggle { @Anchor = (Width: 316, Height: 40, Bottom: 8); @Text = "Pause game"; Visible: false; }
        $C.@CancelTextButton #ResetMatch { @Anchor = (Width: 316, Height: 40); @Text = "End match"; }
      }
    }

    Group {
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Height: 38);
      Padding: (Horizontal: 12, Vertical: 9);

      Label #Hint {
        Style: (FontSize: 11, TextColor: #c9d1d9, Wrap: true);
        Text: "";
      }
    }
  }
}

$C.@BackButton {}
