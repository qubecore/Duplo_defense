$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 560, Height: 820);

  #Title {
    Group {
      LayoutMode: Left;

      $C.@Title #TitleLabel {
        @Text = "Duplo TD: cheat panel";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #Subtitle {
      Anchor: (Bottom: 12);
      Style: (FontSize: 13, TextColor: #96a9be, Wrap: true);
      Text: "Gold, hollow cores, modules, tower ranges, and a quick jump to the desired wave.";
    }

    Group {
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      LayoutMode: Top;
      Anchor: (Bottom: 12);
      Padding: (Horizontal: 12, Vertical: 12);

      Label #Wave {
        Style: (FontSize: 16, RenderBold: true, TextColor: #ffffff);
        Text: "Wave: -";
      }

      Label #Balance {
        Anchor: (Top: 6);
        Style: (FontSize: 16, RenderBold: true, TextColor: #E8A93B);
        Text: "Funds: -";
      }

      Label #Bank {
        Anchor: (Top: 6);
        Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff);
        Text: "Hollow Health: -";
      }

      Label #Status {
        Anchor: (Top: 6);
        Style: (FontSize: 14, RenderBold: true, TextColor: #96a9be);
        Text: "Status: -";
      }

      Label #Cores {
        Anchor: (Top: 6);
        Style: (FontSize: 14, RenderBold: true, TextColor: #D9C57A);
        Text: "Hollow cores: -";
      }
    }

    Label #MoneyHeader {
      Anchor: (Bottom: 8);
      Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #878e9c);
      Text: "Gold";
    }

    Group {
      LayoutMode: Left;
      Anchor: (Bottom: 8);

      $C.@TextButton #MoneyPlus100 { @Anchor = (Width: 120, Right: 8); @Text = "+100"; }
      $C.@TextButton #MoneyPlus1000 { @Anchor = (Width: 120, Right: 8); @Text = "+1000"; }
      $C.@TextButton #MoneyPlus5000 { @Anchor = (Width: 120); @Text = "+5000"; }
    }

    Group {
      LayoutMode: Left;
      Anchor: (Bottom: 14);

      $C.@SecondaryTextButton #MoneyMinus100 { @Anchor = (Width: 120, Right: 8); @Text = "-100"; }
      $C.@SecondaryTextButton #MoneyMinus1000 { @Anchor = (Width: 120, Right: 8); @Text = "-1000"; }
      $C.@SecondaryTextButton #MoneyMinus5000 { @Anchor = (Width: 120); @Text = "-5000"; }
    }

    Label #CoreHeader {
      Anchor: (Bottom: 8);
      Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #878e9c);
      Text: "Hollow cores";
    }

    Group {
      LayoutMode: Left;
      Anchor: (Bottom: 14);

      $C.@TextButton #CoresPlus10 { @Anchor = (Width: 120, Right: 8); @Text = "+10"; }
      $C.@TextButton #CoresPlus50 { @Anchor = (Width: 120, Right: 8); @Text = "+50"; }
      $C.@TextButton #CoresPlus100 { @Anchor = (Width: 120); @Text = "+100"; }
    }

    Label #ModuleHeader {
      Anchor: (Bottom: 8);
      Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #878e9c);
      Text: "Modules and debug";
    }

    Group {
      LayoutMode: Left;
      Anchor: (Bottom: 8);

      $C.@TextButton #GrantModules {
        @Anchor = (Width: 180, Right: 8);
        @Text = "Grant one of each";
      }

      $C.@SecondaryTextButton #ToggleRanges {
        @Anchor = (Width: 180);
        @Text = "Tower ranges: OFF";
      }
    }

    Label #WaveHeader {
      Anchor: (Bottom: 8);
      Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #878e9c);
      Text: "Starting wave";
    }

    Group {
      LayoutMode: Left;
      Anchor: (Bottom: 14);

      TextField #WaveInput {
        Style: $C.@DefaultInputFieldStyle;
        PlaceholderStyle: $C.@DefaultInputFieldPlaceholderStyle;
        Background: $C.@InputBoxBackground;
        Anchor: (Width: 180, Height: 38, Right: 8);
        Padding: (Horizontal: 10);
        PlaceholderText: "Example: 30";
        MaxLength: 4;
      }

      $C.@TextButton #SetWave {
        @Anchor = (Width: 180);
        @Text = "Set wave";
      }
    }

    Label #Hint {
      Anchor: (Bottom: 12);
      Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true);
      Text: "";
    }
  }
}

$C.@BackButton {}
