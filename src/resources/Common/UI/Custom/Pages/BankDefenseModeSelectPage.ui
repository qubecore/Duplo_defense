$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 980, Height: 380);

  #Title {
    Group {
      LayoutMode: Left;

      $C.@Title #TitleLabel {
        @Text = "Duplo TD: mode select";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group {
      Anchor: (Height: 212, Bottom: 18);
      LayoutMode: Left;
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 16, Vertical: 16);

      Group {
        Anchor: (Width: 180, Height: 180, Right: 16);
        Background: (TexturePath: "TutorialIcons/wizard_defaultlook.png", Border: 8);
      }

      Group {
        Anchor: (Width: 736);
        LayoutMode: Top;

        Label #Header {
          Anchor: (Bottom: 16);
          Style: (FontSize: 24, RenderBold: true, TextColor: #ffffff, Wrap: true);
          Text: "Do you want to travel to DUO mode?";
        }

        Label #Body {
          Anchor: (Bottom: 22);
          Style: (FontSize: 16, TextColor: #c9d1d9, Wrap: true);
          Text: "You will be teleported to another map.";
        }
      }
    }

    Group {
      Anchor: (Height: 52, Bottom: 18);
      LayoutMode: Left;

      $C.@SecondaryTextButton #ConfirmButton {
        @Anchor = (Width: 260, Height: 52, Right: 12);
        @Text = "Yes";
      }

      $C.@TextButton #CancelButton {
        @Anchor = (Width: 260, Height: 52, Left: 12);
        @Text = "No";
      }
    }

    Label #Hint {
      Anchor: (Bottom: 10);
      Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true);
      Text: "";
    }
  }
}

$C.@BackButton {}
