$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 980, Height: 556);

  #Title {
    Group {
      LayoutMode: Left;

      $C.@Title #TitleLabel {
        @Text = "Duplo TD: statistics";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group {
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Height: 56, Bottom: 12);
      Padding: (Horizontal: 18, Vertical: 14);

      Label #Header {
        Style: (FontSize: 28, TextColor: #f4d06f, RenderBold: true, Wrap: true);
        Text: "Defender statistics";
      }
    }

    Group {
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Height: 228, Bottom: 12);
      LayoutMode: Top;
      Padding: (Horizontal: 18, Vertical: 18);

      Label #LifetimeTitle {
        Style: (FontSize: 22, TextColor: #8fd3ff, RenderBold: true);
        Text: "Lifetime stats";
      }

      Label #LifetimeBody {
        Anchor: (Top: 10);
        Style: (FontSize: 17, TextColor: #f3f7ff, Wrap: true);
        Text: "";
      }
    }

    Group {
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Height: 128, Bottom: 10);
      LayoutMode: Top;
      Padding: (Horizontal: 18, Vertical: 16);

      Label #BestRunTitle {
        Style: (FontSize: 22, TextColor: #f4d06f, RenderBold: true);
        Text: "Best run";
      }

      Label #BestRunBody {
        Anchor: (Top: 8);
        Style: (FontSize: 17, TextColor: #f3f7ff, Wrap: true);
        Text: "";
      }
    }

    Group {
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Height: 48);
      Padding: (Horizontal: 12, Vertical: 10);

      Label #Hint {
        Style: (FontSize: 13, TextColor: #c9d1d9, Wrap: true);
        Text: "";
      }
    }
  }
}

$C.@BackButton {}
